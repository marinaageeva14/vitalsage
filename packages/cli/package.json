{
  "name": "vitalsage-cli",
  "version": "0.1.0",
  "description": "CLI for VitalSage — npx vitalsage",
  "type": "module",
  "bin": {
    "vitalsage": "./dist/index.cjs"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build":     "tsup",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run",
    "lint":      "eslint src --ext .ts",
    "clean":     "rm -rf dist"
  },
  "dependencies": {
    "@vitalsage/types":    "workspace:*",
    "vitalsage-analysis":  "workspace:*",
    "vitalsage-simulator": "workspace:*",
    "playwright":         "^1.44.0",
    "fast-xml-parser":    "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup":        "^8.5.1",
    "vitest":      "^1.6.0"
  }
}
