{
  "name": "vitalsage-cli",
  "version": "0.1.0",
  "description": "CLI for VitalSage — npx vitalsage",
  "type": "module",
  "bin": {
    "vitalsage": "./dist/index.cjs"
  },
  "main":  "./dist/index.cjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "types":   "./dist/types/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build":     "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run --passWithNoTests",
    "lint":      "eslint src --ext .ts",
    "clean":     "rm -rf dist"
  },
  "dependencies": {
    "@vitalsage/types":    "workspace:*",
    "vitalsage-analysis":  "workspace:*",
    "vitalsage-simulator": "workspace:*"
  },
  "devDependencies": {
    "vitest":      "^1.6.0",
    "@types/node": "^20.0.0"
  }
}
