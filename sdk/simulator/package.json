{
  "name": "vitalsage-simulator",
  "version": "0.1.0",
  "description": "Playwright synthetic runner for VitalSage",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --emitDeclarationOnly --outDir dist/types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vitalsage/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "playwright": "^1.44.0",
    "tsup": "^8.5.1",
    "vitest": "^1.6.0"
  }
}
