{
  "name": "vitalsage-analysis",
  "version": "0.1.0",
  "description": "AI-assisted web performance analysis engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc --project tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vitalsage/types": "workspace:*",
    "fast-xml-parser": "^5.7.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup":        "^8.5.1",
    "vitest":      "^1.6.1"
  }
}
